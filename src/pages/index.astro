---
import Base from '../layouts/Base.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import ResortCard from '../components/ResortCard.astro';
import { resorts, company } from '../data/site';
import { SHOW_PARTNERS } from '../config';
---
<Base title="home">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Familiereizen op maat</p>
        <h1>De familiekamer die écht bij jullie gezin past</h1>
        <p class="lead">Vertel ons wie er meegaat en wat jullie zoeken. Wij, reizende ouders, komen binnen 2 werkdagen met een persoonlijk voorstel tegen reisagenttarieven.</p>
      </div>
      <EnquiryForm />
    </div>
  </section>

  <section class="trust" aria-label="Waarom Wabokkio">
    <div class="wrap trust-inner">
      <span>✓ Geregistreerd reisagent · IATA TIDS {company.iata}</span>
      <span>✓ Offerte binnen 2 werkdagen</span>
      <span>✓ Geen servicefee</span>
      <span>✓ Persoonlijk advies van reizende ouders</span>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Onze favoriete familieresorts</h2>
      <p class="section-lead">Een greep uit de resorts die we graag aanraden. Prijzen hangen af van jullie data en gezin, daarom maken we altijd een offerte op maat.</p>
      <div class="cards">{resorts.slice(0, 6).map((r) => <ResortCard r={r} />)}</div>
      <p class="center"><a class="btn btn-ghost" href="/bestemmingen/">Alle bestemmingen</a></p>
    </div>
  </section>

  <section class="section how">
    <div class="wrap">
      <h2>Hoe het werkt</h2>
      <ol class="steps">
        <li><span class="step-n">1</span><h3>Vertel wie er meegaat</h3><p>Bestemming, data, kamers en de leeftijden van de kinderen. Meer hebben we niet nodig.</p></li>
        <li><span class="step-n">2</span><h3>Wij zoeken uit</h3><p>We vergelijken kamers, kinderclubs en tarieven en kiezen wat echt bij jullie past.</p></li>
        <li><span class="step-n">3</span><h3>Je krijgt een voorstel</h3><p>Binnen 2 werkdagen een persoonlijke offerte met eerlijk advies. Vrijblijvend.</p></li>
        <li><span class="step-n">4</span><h3>Genieten</h3><p>Akkoord? Dan boeken wij het voor jullie. Jullie hoeven alleen nog de koffers te pakken.</p></li>
      </ol>
    </div>
  </section>
  {SHOW_PARTNERS && <section class="partners" aria-label="Onze partners">
    <div class="wrap partners-inner"><span class="partners-label">Onze partners</span><span>Ratehawk</span><span>Expedia TAAP</span></div>
  </section>}
</Base>
