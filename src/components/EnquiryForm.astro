---
import { resorts } from '../data/site';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---
<form id="aanvraag" class="enquiry" method="post" action="/api/aanvraag" novalidate>
  <h2 class="enquiry-title">Waar willen jullie naartoe?</h2>
  <div class="grid-3">
    <label class="field span-3-sm">
      <span>Bestemming of resort</span>
      <input name="bestemming" list="resort-list" required maxlength="200" placeholder="Bijv. Mallorca of Ikos Porto Petro" autocomplete="off" />
      <datalist id="resort-list">{resorts.map((r) => <option value={r.name} />)}</datalist>
    </label>
    <label class="field"><span>Aankomst</span><input type="date" name="aankomst" required /></label>
    <label class="field"><span>Vertrek</span><input type="date" name="vertrek" required /></label>
  </div>

  <fieldset class="rooms">
    <legend>Kamers en reizigers</legend>
    <div id="rooms">
      <div class="room" data-room="1">
        <div class="room-head"><strong>Kamer 1</strong></div>
        <div class="grid-2">
          <label class="field"><span>Volwassenen</span>
            <select name="kamer-1-volwassenen">{[1,2,3,4].map((n) => <option value={n} selected={n === 2}>{n}</option>)}</select>
          </label>
          <label class="field"><span>Kinderen</span>
            <select name="kamer-1-kinderen" class="kids-count">{[0,1,2,3,4].map((n) => <option value={n}>{n}</option>)}</select>
          </label>
        </div>
        <div class="kid-ages"></div>
      </div>
    </div>
    <button type="button" id="add-room" class="btn btn-ghost btn-sm">+ Kamer toevoegen</button>
    <input type="hidden" name="kamers" value="1" />
    <p class="hint">Van kinderen vragen we alleen de leeftijd bij aankomst, geen namen of geboortedata.</p>
  </fieldset>

  <div class="grid-3">
    <label class="field"><span>Naam</span><input name="naam" required maxlength="120" autocomplete="name" /></label>
    <label class="field"><span>E-mail</span><input type="email" name="email" required maxlength="200" autocomplete="email" /></label>
    <label class="field"><span>Telefoon <em>(optioneel)</em></span><input type="tel" name="telefoon" maxlength="40" autocomplete="tel" /></label>
  </div>
  <label class="field"><span>Bericht <em>(optioneel)</em></span><textarea name="bericht" rows="3" maxlength="3000" placeholder="Wensen, budget, kinderclub, babybedje…"></textarea></label>

  <!-- Honeypot: verborgen voor mensen, bots vullen het in -->
  <div class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>

  {siteKey ? <div class="cf-turnstile" data-sitekey={siteKey} data-language="nl"></div>
           : <div class="turnstile-placeholder" aria-hidden="true"><!-- Cloudflare Turnstile: zet PUBLIC_TURNSTILE_SITE_KEY om te activeren --></div>}

  <button type="submit" class="btn btn-primary btn-lg">Vraag vrijblijvend een offerte aan</button>
  <p class="privacy-line">We gebruiken je gegevens alleen voor je offerte. <a href="/privacyverklaring/">Privacyverklaring</a></p>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>
{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script is:inline src="/js/form.js" defer></script>
