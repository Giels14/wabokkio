---
import { hotels } from '../data/hotels';
import { resorts } from '../data/site';
import { t, r, type Lang } from '../i18n';
const { lang, showTitle = true } = Astro.props as { lang: Lang; showTitle?: boolean };
const f = t(lang).form;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const preset = (Astro.url.searchParams.get('hotel') || Astro.url.searchParams.get('resort') || '').slice(0, 200);
const names = [...hotels.map((h) => h.name), ...resorts.map((x) => x.name)];
const jsText = JSON.stringify({ childAge: f.childAge, choose: f.choose, baby: f.baby, years: f.years, sending: f.sending, errDates: f.errDates, errGeneric: f.errGeneric, errNetwork: f.errNetwork, thanks: r('thanks', lang), home: r('home', lang) });
const adults = [1, 2, 3, 4, 5, 6, 7, 8];
const kids = [0, 1, 2, 3, 4, 5, 6, 7, 8];
---
<form id="aanvraag" class="enquiry" method="post" action="/api/aanvraag" novalidate data-i18n={jsText}>
  {showTitle && <h2 class="enquiry-title">{f.title}</h2>}
  <input type="hidden" name="taal" value={lang} />
  <label class="field">
    <span>{f.destination}</span>
    <input name="bestemming" list="resort-list" required maxlength="200" placeholder={f.destinationPh} autocomplete="off" value={preset} />
    <datalist id="resort-list">{names.map((name) => <option value={name} />)}</datalist>
  </label>
  <div class="grid-2">
    <label class="field"><span>{f.arrival}</span><input type="date" name="aankomst" required /></label>
    <label class="field"><span>{f.departure}</span><input type="date" name="vertrek" required /></label>
  </div>

  <fieldset class="party">
    <legend>{f.party}</legend>
    <div class="grid-2">
      <label class="field"><span>{f.adults}</span>
        <select name="volwassenen">{adults.map((n) => <option value={n} selected={n === 2}>{n}</option>)}</select>
      </label>
      <label class="field"><span>{f.children}</span>
        <select name="kinderen" class="kids-count">{kids.map((n) => <option value={n}>{n}</option>)}</select>
      </label>
    </div>
    <div id="kid-ages" class="kid-ages"></div>
    <p class="hint">{f.kidsHint}</p>
  </fieldset>

  <div class="grid-3 grid-contact">
    <label class="field"><span>{f.name}</span><input name="naam" required maxlength="120" autocomplete="name" /></label>
    <label class="field"><span>{f.email}</span><input type="email" name="email" required maxlength="200" autocomplete="email" /></label>
    <label class="field"><span>{f.phone} <em>{f.optional}</em></span><input type="tel" name="telefoon" maxlength="40" autocomplete="tel" /></label>
  </div>
  <label class="field"><span>{f.budget} <em>{f.optional}</em></span><input name="budget" maxlength="80" placeholder={f.budgetPh} /></label>
  <label class="field"><span>{f.message} <em>{f.optional}</em></span><textarea name="opmerkingen" rows="3" maxlength="3000" placeholder={f.messagePh}></textarea></label>

  <div class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>

  <label class="consent">
    <input type="checkbox" name="toestemming" value="ja" required />
    <span>{f.consent} <a href={r('privacy', lang)}>{f.privacyLink}</a>.</span>
  </label>

  {siteKey ? <div class="cf-turnstile" data-sitekey={siteKey} data-language={lang}></div>
           : <div class="turnstile-placeholder" aria-hidden="true"></div>}

  <button type="submit" class="btn btn-primary btn-lg">{f.submit}</button>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>
{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script is:inline src="/js/form.js" defer></script>
