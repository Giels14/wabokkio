---
// Merklogo's: tekst omgezet naar paden en raster-pinguïn vervangen door de vector-mark (scripts/svg-text-to-paths.py).
import { t, r, type Lang } from '../i18n';
interface Props { variant?: 'header' | 'header-white' | 'stacked' | 'stacked-white'; lang: Lang }
const { variant = 'header', lang } = Astro.props;
const dims = variant.startsWith('stacked') ? [300, 230] : [400, 100];
---
<a href={r('home', lang)} class={`logo logo-${variant}`} aria-label={t(lang).nav.home}>
  <img src={`/wabokkio-logo-${variant}.svg`} alt="Wabokkio" width={dims[0]} height={dims[1]} />
</a>
