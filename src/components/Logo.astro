---
// Merklogo (tekst omgezet naar paden met scripts/svg-text-to-paths.py, dus fontonafhankelijk als <img>).
interface Props { variant?: 'light' | 'white' }
const { variant = 'light' } = Astro.props;
const src = variant === 'white' ? '/wabokkio-logo-white.svg' : '/wabokkio-logo.svg';
---
<a href="/" class="logo" aria-label="Wabokkio, naar home">
  <img src={src} alt="Wabokkio" width="420" height="100" />
</a>
