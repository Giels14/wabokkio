{
  "$ref": "#/definitions/blog",
  "definitions": {
    "blog": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "updated": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "errorMessage": {
            "pattern": "slug: alleen kleine letters, cijfers en streepjes"
          }
        },
        "lang": {
          "type": "string",
          "enum": [
            "nl",
            "en"
          ]
        },
        "translationKey": {
          "type": "string"
        },
        "hreflang": {
          "type": "object",
          "properties": {
            "nl": {
              "type": "string"
            },
            "en": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "draft": {
          "type": "boolean",
          "default": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "date",
        "slug",
        "lang"
      ],
      "additionalProperties": true
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}